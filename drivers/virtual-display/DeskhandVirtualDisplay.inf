[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Manufacturer%
CatalogFile=DeskhandVirtualDisplay.cat
DriverVer=10/21/2026,0.1.0.0
PnpLockDown=1

[Manufacturer]
%Manufacturer%=Models,NT$ARCH$.10.0...22000
[Models.NT$ARCH$.10.0...22000]
%DeviceName%=Install,DeskhandVirtualDisplay

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy
[Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Hardware
[Hardware]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"DeskhandVirtualDisplay-470ec75d-a5a9-478b-b547-70038ce1349b"
[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services
[Install.NT.Wdf]
UmdfService=DeskhandVirtualDisplay,Service
UmdfServiceOrder=DeskhandVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients
[Service]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\DeskhandVirtualDisplay.dll
UmdfExtensions=IddCx0102
[DestinationDirs]
DriverCopy=13
[DriverCopy]
DeskhandVirtualDisplay.dll
[SourceDisksFiles]
DeskhandVirtualDisplay.dll=1
[SourceDisksNames]
1=%DiskName%
[Strings]
Manufacturer="Deskhand"
DeviceName="Deskhand Virtual Display"
DiskName="Deskhand Virtual Display Driver"

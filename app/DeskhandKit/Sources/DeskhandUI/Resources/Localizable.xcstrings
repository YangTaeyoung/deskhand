    "screen.stop.noEncoder.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래픽 드라이버를 최신 버전으로 업데이트한 뒤 다시 시도하세요. 가상 머신이나 원격 데스크톱 전용 그래픽 어댑터에는 하드웨어 인코더가 없을 수 있습니다."
          }
        }
      }
    },

      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 화면 전송을 멈췄습니다. 다시 연결해도 계속되면 진단을 실행하세요."
          }
        }
      }
    },
    "screen.stop.other.title": {
      "comment": "Remote screen UI text",

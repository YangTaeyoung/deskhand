    "banner.ai.message": {
      "comment": "Workspace banner while an AI client controls the computer: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 제어권을 가져올 수 있고, 툴바의 긴급 정지(⇧⌘.)로 AI 입력을 바로 멈출 수 있습니다."
          }
        }
      }
    },
    "banner.ai.title": {
      "comment": "Workspace banner title while an AI client without a name controls the computer",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 조작 중"
          }
        }
      }
    },
    "banner.ai.titleWithClient": {
      "comment": "Workspace banner title while an AI client controls the computer: client name",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 조작 중 — %@"
          }
        }
      }
    },
    "banner.aiPaused.message": {
      "comment": "Workspace banner after an emergency stop: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI에게 넘기기 전까지 AI는 이 PC를 조작할 수 없습니다."
          }
        }
      }
    },
    "banner.aiPaused.title": {
      "comment": "Workspace banner after an emergency stop: title",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 일시정지됨"
          }
        }
      }
    },
    "banner.blocked.message": {
      "comment": "Workspace banner when the agent certificate does not match: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 다시 설치했다면 다시 페어링하세요. 아니라면 다른 PC가 이 주소를 쓰는지 먼저 진단하세요."
          }
        }
      }
    },
    "banner.connecting.message": {
      "comment": "Workspace banner while connecting: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 연결로 에이전트에 접속하고 있습니다."
          }
        }
      }
    },
    "banner.human.message": {
      "comment": "Workspace banner while the person at this Mac controls the computer: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI의 입력은 거절됩니다. 작업을 마치면 AI에게 넘기세요."
          }
        }
      }
    },
    "banner.locked.message": {
      "comment": "Workspace banner while Windows shows its lock screen: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 PC 앞에서 잠금을 해제하세요. 그동안은 사람도 AI도 화면과 입력을 쓸 수 없습니다."
          }
        }
      }
    },
    "banner.locked.title": {
      "comment": "Workspace banner while Windows shows its lock screen: title",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows가 잠겨 있습니다"
          }
        }
      }
    },
    "banner.reconnecting.message": {
      "comment": "Workspace banner while reconnecting: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되면 바로 이어서 쓸 수 있습니다. 결과를 모르는 작업은 다시 실행하지 않습니다."
          }
        }
      }
    },
    "cap.clipboard": {

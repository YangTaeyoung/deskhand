{
  "sourceLanguage": "ko",
  "strings": {
    "a11y.capability": {
      "comment": "VoiceOver label of a capability chip: capability name, state",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "a11y.connectionState": {
      "comment": "VoiceOver label of a status dot",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태: %@"
          }
        }
      }
    },
    "a11y.control": {
      "comment": "VoiceOver label of the control pill",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어권: %@"
          }
        }
      }
    },
    "a11y.step": {
      "comment": "VoiceOver label of a step: index, count, title, status",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld단계, %3$@, %4$@"
          }
        }
      }
    },
    "action.retry": {
      "comment": "Button that repeats a failed operation",

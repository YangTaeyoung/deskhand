    "screen.stop.accessLost.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows가 화면 접근을 잠시 잃었습니다. 해상도 변경이나 전체 화면 전환 뒤에 생기며, 자동으로 다시 시도합니다."
          }
        }
      }
    },
    "screen.stop.accessLost.title": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 다시 가져오는 중…"
          }
        }
      }
    },
    "screen.stop.disconnected.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 세션은 남아 있지만 원격 데스크톱 연결이 끊겨 그릴 화면이 없습니다. PC 앞에서 로그인하거나, PC의 관리자 명령 프롬프트에서 아래 명령으로 세션을 콘솔로 옮기면 화면이 나타납니다."
          }
        }
      }
    },
    "screen.stop.disconnected.title": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 세션이 화면에 연결되어 있지 않습니다"
          }
        }
      }
    },
    "screen.stop.display.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결이 끊겼거나 꺼져 있어 화면을 가져올 수 없습니다. 모니터 연결을 확인한 뒤 다시 시도하거나 다른 디스플레이를 고르세요."
          }
        }
      }
    },
    "screen.stop.display.title": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이를 찾을 수 없습니다"
          }
        }
      }
    },
    "screen.stop.locked.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 앞에서 잠금을 풀면 화면이 바로 이어집니다. 잠금 화면은 원격으로 조작할 수 없습니다."
          }
        }
      }
    },
    "screen.stop.locked.title": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows가 잠겨 있습니다"
          }
        }
      }
    },
    "screen.stop.noEncoder.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래픽 드라이버를 최신 버전으로 업데이트한 뒤 다시 시도하세요. 가상 머신이나 원격 데스크톱 전용 그래픽 어댑터에는 하드웨어 인코더가 없을 수 있습니다."
          }
        }
      }
    },
    "screen.stop.noEncoder.title": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC에서 H.264 인코더를 찾지 못했습니다"
          }
        }
      }
    },
    "screen.stop.noOutput.message": {
      "comment": "Remote screen UI text",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터가 꺼져 있거나 연결되지 않아 Windows가 %@에 화면을 그리지 않습니다. 모니터를 켜거나 HDMI 더미 플러그를 연결한 뒤 다시 시도하세요."
          }
        }
      }
    },
    "screen.stop.noOutput.title": {

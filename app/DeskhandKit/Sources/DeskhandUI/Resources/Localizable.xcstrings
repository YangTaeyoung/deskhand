    "banner.blocked.message": {
      "comment": "Workspace banner when the agent certificate does not match: message",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 다시 설치했다면 다시 페어링하세요. 아니라면 다른 컴퓨터가 이 주소를 쓰는지 먼저 진단하세요."
          }
        }
      }
    },
    "banner.connecting.message": {
